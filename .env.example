# ------------------------------------------------------------------
# قالب فایل محیطی
# برای استفاده، این فایل را با نام .env کپی کنید:
#   cp .env.example .env
# ------------------------------------------------------------------

# --- نام/پورت پروژه (داکر) ---
APP_NAME=anbar-php
APP_TITLE=anbar
APP_DOCKER_NETWORK=anbar
APP_PORT=8000

# --- اتصال MySQL / MariaDB ---
# اگر فایل .env وجود نداشته باشد یا کلیدی تعریف نشده باشد،
# اتصال به صورت خودکار از مقادیر هاردکد داخل
# Database/database_connector.php استفاده می‌کند.
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=pro
DB_USERNAME=root
DB_PASSWORD=password

# --- آدرس‌های سایت ---
# اگر این کلیدها تعریف نشوند، مقادیر پیش‌فرض پروداکشن از
# config/app.php استفاده می‌شود (anbaritoys.ir و سابدامین‌ها).
# نمونه لوکال (داکر با سابفولدرها):
#   APP_URL=http://localhost:8008
#   PUBLIC_URL=/photos
#   ZARINPAL_CALLBACK=http://localhost:8008/callback.php
APP_URL=
PUBLIC_URL=
ZARINPAL_CALLBACK=
